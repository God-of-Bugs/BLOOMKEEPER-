; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BLOOMKEEPER"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280.0
window/size/viewport_height=720.0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_forward="{\"deadzone\": 0.5, \"events\": [Object(InputEventKey, \"physical_keycode\": 87, \"device\": -1)]}"
move_back="{\"deadzone\": 0.5, \"events\": [Object(InputEventKey, \"physical_keycode\": 83, \"device\": -1)]}"
move_left="{\"deadzone\": 0.5, \"events\": [Object(InputEventKey, \"physical_keycode\": 65, \"device\": -1)]}"
move_right="{\"deadzone\": 0.5, \"events\": [Object(InputEventKey, \"physical_keycode\": 68, \"device\": -1)]}"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
